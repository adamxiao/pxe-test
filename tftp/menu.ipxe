kernel ${base-url}/vmlinuz
initrd ${base-url}/initrd
imgargs vmlinuz initrd=initrd ip=dhcp url=http://10.30.9.99:9080/ubuntu2404/ubuntu-24.04-desktop-amd64.iso
boot || goto failed
goto start

# install failed twice
:ubuntu2604-iso-install
set base-url ${http-url}/ubuntu2604
kernel ${base-url}/vmlinuz
initrd ${base-url}/initrd
imgargs vmlinuz initrd=initrd ip=dhcp url=http://10.30.9.99:9080/ubuntu2604/ubuntu-26.04-desktop-amd64.iso
boot || goto failed
goto start

:ubuntu2604-iso-install2
set base-url ${http-url}/ubuntu2604
kernel ${base-url}/vmlinuz
initrd ${base-url}/initrd
imgargs vmlinuz ip=dhcp boot=casper iso-url=http://10.30.9.99:9080/ubuntu2604/ubuntu-26.04-desktop-amd64.iso
boot || goto failed
goto start

:ubuntu2604-iso-install3
set base-url ${http-url}/ubuntu2604
kernel ${base-url}/vmlinuz
initrd ${base-url}/initrd
imgargs vmlinuz initrd=initrd root=/dev/ram0 ramdisk_size=8388608 \
  boot=casper netboot=url ip=dhcp cloud-config-url=/dev/null \
  url=http://10.30.9.99:9080/ubuntu2604/ubuntu-26.04-desktop-amd64.iso
boot || goto failed
goto start

:zstack-inspect
set base-url ${http-url}/zstack
kernel ${base-url}/vmlinuz
initrd ${base-url}/initrd.img
imgargs vmlinuz initrd=initrd.img devfs=nomount ksdevice=bootif ks=${http-url}/inspector_ks.cfg vnc
boot || goto failed
goto start

:centos-install
echo Starting KSVD mmj x86-64 installer for iscsi:10.30.9.99::::iqn.2005-10.org.freenas.ctl:centos7
set base-url ${http-url}/ksvd819-1-mmj-x86
set keep-san 1
kernel ${base-url}/images/pxeboot/vmlinuz initrd=initrd.img ip=dhcp net.ifnames=0 biosdevname=0 method=${base-url} ks=${base-url}/kickstart/ks.cfg devfs=nomount
initrd ${base-url}/images/pxeboot/initrd.img
boot || goto failed
goto start

:centos9-ironic
echo Starting centos9 ironic
set base-url ${http-url}/centos9-ironic
imgfree
kernel ${base-url}/deploy_kernel selinux=0 troubleshoot=0 text nofb nomodeset vga=normal console=tty0 console=ttyS0,115200n8 initrd=deploy_ramdisk || goto retry
initrd ${base-url}/deploy_ramdisk || goto retry
boot || goto failed
goto start

:openeuler-2203-x86-install
echo Starting install openEuler-22.03-LTS-SP3-x86_64-dvd.iso
set base-url ${http-url}/openeuler-x86
set keep-san 1
#kernel ${base-url}/images/pxeboot/vmlinuz ip=dhcp net.ifnames=0 biosdevname=0 inst.repo=${base-url} inst.ks=${base-url}/ks/ks.cfg devfs=nomount
kernel ${base-url}/images/pxeboot/vmlinuz ip=dhcp net.ifnames=0 biosdevname=0 inst.repo=${base-url} devfs=nomount
initrd ${base-url}/images/pxeboot/initrd.img
boot || goto failed
goto start

